Õ=>?@AB_WebResourceFrameName_1file:///Users/afinkelstein/Downloads/index_3.htmlUUTF-8O␀3«<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8">
<meta name="p:domain_verify" content="211c0aef6c212d0a755234515a5a797f">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vivazia Living â€” Simplify. Inspire. Elevate.</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&amp;family=Jost:wght@200;300;400;500&amp;display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0F1E45;
  --navy-mid:#1B2D5E;
  --gold:#C9A96E;
  --gold-light:#E2C99A;
  --gold-pale:#F5EDDC;
  --cream:#F8F4EF;
  --warm-white:#FDFBF8;
  --text:#1a1a1a;
  --text-mid:#4a4644;
  --text-light:#9a9590;
}
html{scroll-behavior:smooth}
body{font-family:'Jost',sans-serif;background:var(--warm-white);color:var(--text);overflow-x:hidden}

/* NAV */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;align-items:center;justify-content:space-between;
  padding:1.2rem 5rem;
  background:rgba(253,251,248,0.96);
  backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(201,169,110,0.15);
}
.nav-logo{text-decoration:none;display:flex;flex-direction:column;align-items:flex-start;gap:0}
.nav-logo-main{
  font-family:'Cinzel',serif;font-size:1.1rem;font-weight:600;
  letter-spacing:0.3em;color:var(--navy);line-height:1;
}
.nav-logo-main span{color:var(--gold)}
.nav-logo-rule{width:100%;height:0.5px;background:var(--gold);opacity:0.5;margin:3px 0}
.nav-logo-sub{
  font-family:'Cormorant Garamond',serif;font-size:0.85rem;font-weight:300;
  letter-spacing:0.45em;color:var(--text-light);font-style:italic;
  
}
.nav-links{display:flex;gap:2.5rem;list-style:none;align-items:center}
.nav-links a{
  font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase;
  color:var(--text-mid);text-decoration:none;transition:color 0.2s;font-weight:300;
}
.nav-links a:hover{color:var(--gold)}
.nav-cta{
  background:var(--navy);color:#fff!important;
  padding:0.5rem 1.5rem;transition:background 0.2s!important;
}
.nav-cta:hover{background:var(--gold)!important}

/* HERO */
.hero{display:grid;grid-template-columns:1fr 1fr;min-height:100vh;padding-top:72px}
.hero-left{
  background:var(--cream);
  display:flex;flex-direction:column;justify-content:center;
  padding:6rem 4.5rem 6rem 5.5rem;position:relative;
}
.hero-left::after{
  content:'';position:absolute;right:0;top:12%;bottom:12%;
  width:0.5px;background:var(--gold);opacity:0.25;
}
.hero-eyebrow{
  font-size:0.65rem;letter-spacing:0.35em;text-transform:uppercase;
  color:var(--gold);margin-bottom:2rem;font-weight:300;
}
.hero-logo{margin-bottom:1.5rem}
.hero-logo-main{
  font-family:'Cinzel',serif;font-size:clamp(2.2rem,4vw,3.2rem);
  font-weight:600;letter-spacing:0.3em;color:var(--navy);
  line-height:1;display:block;
}
.hero-logo-main span{color:var(--gold)}
.hero-logo-rule{
  display:block;width:100%;height:0.5px;
  background:var(--gold);opacity:0.4;margin:0.7rem 0;
}
.hero-logo-sub{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(1.5rem,2.5vw,2.2rem);
  font-weight:300;letter-spacing:0.55em;
  color:var(--text-light);font-style:italic;display:block;
}
.hero-tagline{
  font-size:0.68rem;letter-spacing:0.28em;text-transform:uppercase;
  color:var(--text-light);margin-bottom:2rem;font-weight:200;
}
.hero-desc{
  font-size:0.95rem;line-height:1.95;color:var(--text-mid);
  max-width:400px;margin-bottom:3rem;font-weight:300;
}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap}
.btn-primary{
  background:var(--navy);color:#fff;
  padding:0.85rem 2rem;font-size:0.7rem;
  letter-spacing:0.2em;text-transform:uppercase;
  text-decoration:none;transition:background 0.2s;
  font-family:'Jost',sans-serif;font-weight:300;
}
.btn-primary:hover{background:var(--gold)}
.btn-outline{
  border:0.5px solid var(--navy);color:var(--navy);
  padding:0.85rem 2rem;font-size:0.7rem;
  letter-spacing:0.2em;text-transform:uppercase;
  text-decoration:none;transition:all 0.2s;
  font-family:'Jost',sans-serif;font-weight:300;
}
.btn-outline:hover{background:var(--navy);color:#fff}
.hero-right{position:relative;overflow:hidden;background:var(--navy-mid)}
.hero-right img{width:100%;height:100%;object-fit:cover;object-position:center 5%;display:block;opacity:0.95;transform:scale(1.12);transform-origin:top center}
.hero-caption{
  position:absolute;bottom:0;left:0;right:0;
  background:linear-gradient(transparent,rgba(15,30,69,0.7));
  padding:3rem 2.5rem 2rem;
}
.hero-caption-text{
  font-family:'Cormorant Garamond',serif;
  font-size:1.15rem;font-style:italic;font-weight:300;
  color:rgba(255,255,255,0.88);line-height:1.6;
}
.hero-caption-attr{
  font-size:0.62rem;letter-spacing:0.22em;text-transform:uppercase;
  color:var(--gold-light);margin-top:0.5rem;font-weight:300;
}

/* STATS */
.stats-bar{
  background:var(--navy);
  display:grid;grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--gold);
}
.stat{padding:2rem;text-align:center;border-right:1px solid rgba(255,255,255,0.05)}
.stat:last-child{border-right:none}
.stat-num{
  font-family:'Cinzel',serif;font-size:2rem;font-weight:400;color:var(--gold-light);
}
.stat-label{
  font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;
  color:rgba(255,255,255,0.35);margin-top:0.4rem;font-weight:300;
}

/* ABOUT */
.about{display:grid;grid-template-columns:1fr 1fr;min-height:55vh}
.about-img-col{position:relative;overflow:hidden;background:var(--cream)}
.about-img-col img{width:100%;height:100%;object-fit:cover;object-position:center 8%;display:block;max-height:600px;object-fit:cover;transform:scale(1.4);transform-origin:top center}

.about-badge{
  position:absolute;bottom:2.5rem;right:2.5rem;
  background:var(--navy);padding:1.2rem 1.5rem;text-align:center;
}
.about-badge-num{font-family:'Cinzel',serif;font-size:1.8rem;font-weight:400;color:var(--gold-light);display:block}
.about-badge-text{font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.4);display:block;margin-top:0.2rem;font-weight:300}
.about-text{padding:6rem 5rem;background:var(--warm-white);display:flex;flex-direction:column;justify-content:center}
.section-eyebrow{font-size:0.65rem;letter-spacing:0.32em;text-transform:uppercase;color:var(--gold);font-weight:300;margin-bottom:0.8rem;display:block}
.section-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(1.8rem,3vw,2.6rem);
  font-weight:400;color:var(--navy);line-height:1.2;margin-bottom:1.2rem;
}
.section-title em{font-style:italic;color:var(--gold)}
.rule{width:36px;height:0.5px;background:var(--gold);margin-bottom:2rem}
.about-text p{font-size:0.92rem;line-height:1.95;color:var(--text-mid);margin-bottom:1.1rem;font-weight:300}
.about-text p strong{color:var(--navy);font-weight:400}
.about-pull{
  font-family:'Cormorant Garamond',serif;
  font-size:1.25rem;font-style:italic;font-weight:300;
  color:var(--navy);line-height:1.5;
  border-left:1px solid var(--gold);padding-left:1.2rem;margin:1.5rem 0;
}
.about-tags{display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:2rem}
.about-tag{
  font-size:0.62rem;letter-spacing:0.12em;text-transform:uppercase;
  border:0.5px solid rgba(201,169,110,0.4);color:var(--text-light);
  padding:0.32rem 0.85rem;font-weight:300;
}

/* SERVICES */
.services{padding:7rem 5.5rem;background:var(--cream)}
.services-top{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end;margin-bottom:4.5rem}
.services-intro{font-size:0.92rem;line-height:1.95;color:var(--text-mid);font-weight:300}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.service-card{
  background:var(--warm-white);
  border:0.5px solid rgba(201,169,110,0.15);
  overflow:hidden;
  transition:border-color 0.3s,transform 0.3s;
}
.service-card:hover{border-color:var(--gold);transform:translateY(-4px)}
.service-art{
  height:160px;display:flex;align-items:center;justify-content:center;
  background:var(--navy);position:relative;overflow:hidden;
}
.service-art svg{width:80px;height:80px;opacity:0.85}
.service-art-accent{
  position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--gold);opacity:0.4;
}
.service-body{padding:1.8rem 1.6rem}
.service-num{
  font-family:'Cinzel',serif;font-size:0.65rem;letter-spacing:0.25em;
  color:var(--gold);font-weight:400;margin-bottom:0.6rem;display:block;
}
.service-name{
  font-family:'Cormorant Garamond',serif;
  font-size:1.15rem;font-weight:400;color:var(--navy);margin-bottom:0.6rem;
}
.service-desc{font-size:0.82rem;line-height:1.8;color:var(--text-mid);font-weight:300;margin-bottom:1rem}
.service-price{font-size:0.62rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);font-weight:300}

/* PHILOSOPHY */
.philosophy{
  background:var(--navy);padding:7rem 5.5rem;
  display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;
}
.philosophy .section-eyebrow{color:rgba(201,169,110,0.6)}
.philosophy .section-title{color:#fff}
.philosophy .section-title em{color:var(--gold-light)}
.philosophy .rule{background:rgba(201,169,110,0.4)}
.phil-quote{
  font-family:'Cormorant Garamond',serif;
  font-size:1.4rem;font-style:italic;font-weight:300;
  color:#fff;line-height:1.65;
  border-left:1px solid var(--gold);padding-left:1.8rem;margin-bottom:2rem;
}
.phil-body{font-size:0.9rem;line-height:1.95;color:rgba(255,255,255,0.45);margin-bottom:1.2rem;font-weight:300}
.phil-body strong{color:rgba(255,255,255,0.78);font-weight:300}

/* CONTACT */
.contact{display:grid;grid-template-columns:1fr 1fr;min-height:75vh}
.contact-left{padding:6rem 5rem;background:var(--cream);display:flex;flex-direction:column;justify-content:center}
.contact-tagline{font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-style:italic;font-weight:300;color:var(--navy);line-height:1.6;margin-bottom:1.5rem}
.contact-body{font-size:0.88rem;line-height:1.9;color:var(--text-mid);font-weight:300;margin-bottom:2.5rem}
.contact-details{display:flex;flex-direction:column;gap:1rem}
.contact-detail-label{font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:0.2rem;font-weight:300}
.contact-detail-value{font-size:0.88rem;color:var(--navy);font-weight:300}
.contact-right{background:var(--navy);padding:6rem 5rem;display:flex;flex-direction:column;justify-content:center}
.contact-right .section-eyebrow{color:rgba(201,169,110,0.6)}
.contact-right .section-title{color:#fff}
.contact-right .section-title em{color:var(--gold-light)}
.contact-right .rule{background:rgba(201,169,110,0.4)}
.contact-form{display:flex;flex-direction:column;gap:0.9rem}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:0.9rem}
.contact-form input,.contact-form textarea,.contact-form select{
  background:rgba(255,255,255,0.05);border:0.5px solid rgba(255,255,255,0.1);
  color:#fff;padding:0.85rem 1.1rem;font-family:'Jost',sans-serif;
  font-size:0.82rem;font-weight:300;width:100%;outline:none;transition:border-color 0.2s;
}
.contact-form input::placeholder,.contact-form textarea::placeholder{color:rgba(255,255,255,0.22)}
.contact-form input:focus,.contact-form textarea:focus,.contact-form select:focus{border-color:var(--gold)}
.contact-form select option{background:var(--navy)}
.contact-form textarea{height:110px;resize:vertical}

/* FOOTER */
footer{
  background:#060E28;padding:2rem 5.5rem;
  display:flex;align-items:center;justify-content:space-between;
  border-top:0.5px solid rgba(201,169,110,0.1);
}
.footer-logo-main{font-family:'Cinzel',serif;font-size:0.9rem;letter-spacing:0.28em;color:rgba(255,255,255,0.25)}
.footer-logo-main span{color:rgba(201,169,110,0.35)}
.footer-tagline{font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:rgba(255,255,255,0.18);font-weight:300}
.footer-copy{font-size:0.6rem;letter-spacing:0.1em;color:rgba(255,255,255,0.15)}

/* FADE */
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
.hero-eyebrow{animation:fadeUp 0.7s 0.1s both}
.hero-logo{animation:fadeUp 0.7s 0.25s both}
.hero-tagline{animation:fadeUp 0.7s 0.38s both}
.hero-desc{animation:fadeUp 0.7s 0.48s both}
.hero-btns{animation:fadeUp 0.7s 0.58s both}
.fade{opacity:0;transform:translateY(16px);transition:opacity 0.7s ease,transform 0.7s ease}
.fade.in{opacity:1;transform:translateY(0)}

@media(max-width:768px){
  nav{padding:0.9rem 1.2rem}
  .nav-links{display:none}
  .hero{grid-template-columns:1fr;min-height:auto}
  .hero-left{order:2;padding:3rem 1.5rem 2.5rem}
  .hero-left::after{display:none}
  .hero-right{order:1;height:60vw;max-height:320px}
  .hero-logo-main{font-size:2rem}
  .hero-logo-sub{font-size:1rem}
  .hero-desc{max-width:100%}
  .btn-navy,.btn-outline,.btn-gold,.btn-outline-white{display:block;text-align:center;margin-right:0;width:100%;margin-bottom:0.8rem}
  .stats{grid-template-columns:repeat(2,1fr)}
  .stat{padding:1.2rem 0.5rem}
  .stat-num{font-size:1.4rem}
  .about{grid-template-columns:1fr}
  .about-img{min-height:60vw;max-height:380px}
  .about-content{padding:2.5rem 1.5rem}
  .connection{grid-template-columns:1fr;height:auto}
  .conn-photo{height:55vw}
  .credibility{grid-template-columns:1fr}
  .cred-img{min-height:60vw;max-height:380px}
  .cred-content{padding:2.5rem 1.5rem}
  .services{padding:3rem 1.2rem}
  .services-header{grid-template-columns:1fr;gap:1rem;margin-bottom:2rem}
  .services-grid{grid-template-columns:1fr!important;gap:1rem}
  .service-card{width:100%}
  .charleston-section{height:280px}
  .charleston-content{left:1.5rem;max-width:90%}
  .philosophy-content{padding:3rem 1.5rem;max-width:100%}
  .contact{grid-template-columns:1fr}
  .contact-left,.contact-right{padding:3rem 1.5rem}
  .form-row{grid-template-columns:1fr}
  footer{flex-direction:column;gap:0.8rem;text-align:center;padding:1.5rem}
  .section-title{font-size:1.5rem}
  .portrait-section{grid-template-columns:1fr}
  .portrait-img{min-height:60vw;max-height:380px}
  .portrait-content{padding:2.5rem 1.5rem}
  .baby{height:250px}
  .hero-tagline{font-size:0.75rem}
}
@media(max-width:480px){
  .hero-left{padding:2.5rem 1.2rem 2rem}
  .about-content,.cred-content,.contact-left,.contact-right,.services,.philosophy-content,.portrait-content{padding-left:1.2rem;padding-right:1.2rem}
  .stat-num{font-size:1.2rem}
  .stat-label{font-size:0.5rem}
  .hero-logo-main{font-size:1.7rem}
}
</style>
</head>
